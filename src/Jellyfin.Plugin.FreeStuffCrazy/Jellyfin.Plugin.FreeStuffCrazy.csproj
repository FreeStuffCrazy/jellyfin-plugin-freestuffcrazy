<Project Sdk="Microsoft.NET.Sdk">

  <!-- One build per Jellyfin line: dotnet build -p:JellyfinVersion=10.11.11.
       Each line runs on its own .NET version. -->
  <PropertyGroup>
    <JellyfinVersion Condition="'$(JellyfinVersion)' == ''">12.4.0</JellyfinVersion>
    <TargetFramework Condition="$(JellyfinVersion.StartsWith('12.'))">net10.0</TargetFramework>
    <TargetFramework Condition="$(JellyfinVersion.StartsWith('10.11.'))">net9.0</TargetFramework>
    <TargetFramework Condition="$(JellyfinVersion.StartsWith('10.9.')) Or $(JellyfinVersion.StartsWith('10.10.'))">net8.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <RootNamespace>Jellyfin.Plugin.FreeStuffCrazy</RootNamespace>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Must match the Jellyfin version the plugin is built for; Jellyfin
         supplies these assemblies at runtime. -->
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.FreeStuffCrazy.Tests" />
  </ItemGroup>

</Project>
